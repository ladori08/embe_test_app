# Copy to .env.prod before first production run
# cp .env.prod.example .env.prod

# Required
JWT_SECRET=replace-with-long-random-secret-at-least-64-chars

# Optional: if Mongo runs in this compose, keep default
MONGODB_URI=mongodb://mongodb:27017/embe?replicaSet=rs0

# Public URL that frontend will call
NEXT_PUBLIC_API_URL=http://localhost:8080

# Comma-separated list of allowed frontend origins for backend CORS
# Example: https://shop.your-domain.com,https://admin.your-domain.com
EMBE_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://127.0.0.1:3000

# Cookie settings:
# Local HTTP: secure=false, same-site=Lax
# HTTPS cross-site: secure=true, same-site=None
EMBE_JWT_COOKIE_SECURE=false
EMBE_JWT_COOKIE_SAME_SITE=Lax

# Optional: Google Drive remote for Database tab restore/list from Drive
# Example: gdrive:EmbeBackups
EMBE_DATABASE_DRIVE_REMOTE=
EMBE_DATABASE_DRIVE_TEMP_DIR=/tmp/embe-database-drive
EMBE_DATABASE_DRIVE_COMMAND_TIMEOUT_SECONDS=300
EMBE_DATABASE_DRIVE_RETENTION_AUTO=16
EMBE_DATABASE_DRIVE_RETENTION_LOGIN=10
